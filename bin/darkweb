#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
darkweb — the Spine / NickOS console.

Layer 5 surface. Phosphor-green CRT readout of the box: memory, load, disk,
secrets hygiene, scheduled jobs, and month-to-date API spend.

Stdlib only. No pip install, ever. (CLAUDE.md section 5 — zero bloat.)

    bin/darkweb                 one-shot render
    bin/darkweb --watch         refresh every 2s until Ctrl-C
    bin/darkweb --watch 10      refresh every 10s
    bin/darkweb --no-color      plain text, for piping and for logs
    bin/darkweb --scanlines     CRT scanline effect, purely decorative
"""

from __future__ import annotations

import argparse
import os
import shutil
import socket
import sys
import time
from datetime import datetime, timezone

VERSION = "0.2.0"
INNER = 70  # printable columns inside the bezel

# Plain mode drops the bezel, the banner and the bar glyphs, and keeps the
# numbers. Set by --plain (which is all bin/status does). It is a module flag
# rather than a parameter threaded through every panel so that the two
# surfaces cannot drift: same compose(), same data, different dress.
PLAIN = False


# ─────────────────────────────────────────────────────────────────────────────
# palette
# ─────────────────────────────────────────────────────────────────────────────

class P:
    """Phosphor palette. Truecolor with a 16-color fallback baked into the
    escape sequence order, so a dumb terminal still gets green-on-black."""

    enabled = True

    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"

    GREEN = "\033[38;2;0;255;0m"      # #00FF00 — phosphor
    GREEN_D = "\033[38;2;0;140;0m"    # dim trace
    GREEN_F = "\033[38;2;0;80;0m"     # faded, bezel and rules
    AMBER = "\033[38;2;255;176;0m"    # warning
    RED = "\033[38;2;255;56;56m"      # critical
    CYAN = "\033[38;2;0;220;200m"     # values / accents
    WHITE = "\033[38;2;220;255;220m"

    @classmethod
    def off(cls):
        cls.enabled = False
        for name in ("RESET", "BOLD", "DIM", "GREEN", "GREEN_D", "GREEN_F",
                     "AMBER", "RED", "CYAN", "WHITE"):
            setattr(cls, name, "")


def supports_color(stream) -> bool:
    if os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("TERM") == "dumb":
        return False
    return hasattr(stream, "isatty") and stream.isatty()


# ─────────────────────────────────────────────────────────────────────────────
# row builder — tracks visible width so colored text still pads correctly
# ─────────────────────────────────────────────────────────────────────────────

class Row:
    __slots__ = ("parts", "w")

    def __init__(self):
        self.parts = []
        self.w = 0

    def add(self, text, color=""):
        text = str(text)
        self.parts.append((color, text))
        self.w += len(text)
        return self

    def render(self, width=INNER):
        """Pad to `width`, and CLIP to it. Clipping matters: a row that
        overruns pushes the bezel out and the whole frame goes ragged."""
        out, used = [], 0
        for color, text in self.parts:
            if used >= width:
                break
            if used + len(text) > width:
                text = text[:width - used]
            used += len(text)
            out.append(f"{color}{text}{P.RESET}" if color else text)
        return "".join(out) + " " * max(0, width - used)


def rule(char="─", color=None):
    return Row().add(char * INNER, color or P.GREEN_F)


def blank():
    return Row()


# ─────────────────────────────────────────────────────────────────────────────
# readings — real where cheap, honestly absent where not yet built
# ─────────────────────────────────────────────────────────────────────────────

def read_meminfo():
    """(total_mb, available_mb, used_pct) or None off Linux."""
    try:
        vals = {}
        with open("/proc/meminfo", "r") as fh:
            for line in fh:
                key, _, rest = line.partition(":")
                vals[key] = int(rest.strip().split()[0])  # kB
        total = vals["MemTotal"] / 1024
        avail = vals.get("MemAvailable", vals.get("MemFree", 0)) / 1024
        return total, avail, (total - avail) / total * 100 if total else 0.0
    except Exception:
        return None


def read_swap():
    try:
        vals = {}
        with open("/proc/meminfo", "r") as fh:
            for line in fh:
                key, _, rest = line.partition(":")
                vals[key] = int(rest.strip().split()[0])
        total = vals.get("SwapTotal", 0) / 1024
        free = vals.get("SwapFree", 0) / 1024
        return total, total - free
    except Exception:
        return None


def read_loadavg():
    try:
        return os.getloadavg()
    except Exception:
        return None


def read_uptime():
    try:
        with open("/proc/uptime", "r") as fh:
            secs = float(fh.read().split()[0])
        d, rem = divmod(int(secs), 86400)
        h, rem = divmod(rem, 3600)
        m = rem // 60
        return f"{d}d {h:02d}h {m:02d}m" if d else f"{h:02d}h {m:02d}m"
    except Exception:
        return None


def read_disk(path="/"):
    try:
        st = os.statvfs(path)
        total = st.f_blocks * st.f_frsize / 2**30
        free = st.f_bavail * st.f_frsize / 2**30
        return total, free, (total - free) / total * 100 if total else 0.0
    except Exception:
        return None


def spine_root():
    """Derived from this script's own path, never from SPINE_ROOT.

    A stale SPINE_ROOT in someone's .env is a leftover, not a decision. See
    core/paths.py for the two times that cost us an outage.
    """
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def env_status():
    """Secrets hygiene is a first-class readout, not an afterthought."""
    path = os.path.join(spine_root(), ".env")
    if not os.path.exists(path):
        return "ABSENT", "not created yet", P.AMBER
    mode = os.stat(path).st_mode & 0o777
    if mode != 0o600:
        return "INSECURE", f"mode {mode:o}, expected 600", P.RED
    return "OK", "mode 600", P.GREEN


def db_status():
    path = os.environ.get("SPINE_DB") or os.path.join(
        spine_root(), "var", "spine.db")
    if not os.path.exists(path):
        return "ABSENT", "no database yet", P.GREEN_D
    size = os.path.getsize(path) / 2**20
    try:
        sys.path.insert(0, spine_root())
        from core import costs  # type: ignore
        conn = costs.connect(path)
        tables = {r[0] for r in conn.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")}
        conn.close()
        has_items = "items" in tables
        note = f"{size:,.1f} MB · costs" + (
            " + items" if has_items else "; items lands in Phase 2")
        return "OK", note, P.GREEN
    except Exception:
        return "OK", f"{size:,.1f} MB", P.GREEN


def lock_status():
    """Is a job running right now?

    Read the pid out of the lock file and check it is alive. Deliberately
    does NOT try to flock() the file: acquiring it, even for a microsecond,
    could make a real job skip — and jobs skip rather than queue.
    """
    lock = os.environ.get("SPINE_LOCK", "/tmp/spine.lock")
    if not os.path.exists(lock):
        return "FREE", "global serialization - CLAUDE.md section 2", P.GREEN
    try:
        with open(lock) as fh:
            pid = int((fh.read().strip() or "0"))
    except Exception:
        pid = 0
    if pid <= 0:
        return "FREE", "global serialization - CLAUDE.md section 2", P.GREEN
    try:
        os.kill(pid, 0)
    except OSError:
        return "FREE", f"stale lock file, pid {pid} gone", P.GREEN
    return "HELD", f"a job is running (pid {pid})", P.AMBER


def load_jobs():
    """Live rows from core.registry (Phase 0). If the registry cannot be
    imported the panel says so rather than showing an empty table — a
    console that invents numbers is worse than one that admits a gap."""
    try:
        sys.path.insert(0, spine_root())
        from core.registry import all_jobs  # type: ignore
        return list(all_jobs()), None
    except Exception:
        return [], "registry lands in Phase 0"


def load_spend():
    """Month-to-date spend, the cap, and the biggest spenders."""
    try:
        sys.path.insert(0, spine_root())
        from core import costs  # type: ignore
        h = costs.headroom()
        h["jobs"] = costs.by_job()[:3]
        h["calls"] = sum(n for _, _, n in costs.by_outcome())
        return h, None
    except Exception as exc:
        return None, f"cost accounting unavailable ({type(exc).__name__})"


# ─────────────────────────────────────────────────────────────────────────────
# widgets
# ─────────────────────────────────────────────────────────────────────────────

def grade(pct, warn=70.0, crit=88.0):
    return P.RED if pct >= crit else P.AMBER if pct >= warn else P.GREEN


def bar(pct, width=24, warn=70.0, crit=88.0):
    pct = max(0.0, min(100.0, float(pct)))
    filled = int(round(pct / 100.0 * width))
    return grade(pct, warn, crit), "█" * filled + "░" * (width - filled)


def metric(label, pct, detail, width=24, warn=70.0, crit=88.0):
    color, glyph = bar(pct, width, warn, crit)
    if PLAIN:
        return (Row()
                .add(f"  {label:<8}", P.GREEN_D)
                .add(f"{pct:5.1f}%  ", color)
                .add(detail, P.GREEN_D))
    return (Row()
            .add(f"  {label:<8}", P.GREEN_D)
            .add(glyph, color)
            .add(f" {pct:5.1f}%  ", color)
            .add(detail, P.GREEN_D))


BANNER = [
    r" ███████╗██████╗ ██╗███╗   ██╗███████╗",
    r" ██╔════╝██╔══██╗██║████╗  ██║██╔════╝",
    r" ███████╗██████╔╝██║██╔██╗ ██║█████╗  ",
    r" ╚════██║██╔═══╝ ██║██║╚██╗██║██╔══╝  ",
    r" ███████║██║     ██║██║ ╚████║███████╗",
    r" ╚══════╝╚═╝     ╚═╝╚═╝  ╚═══╝╚══════╝",
]


def header():
    if PLAIN:
        return [Row().add(f"SPINE / NickOS  personal OS v{VERSION}", P.GREEN)]
    rows = []
    for i, line in enumerate(BANNER):
        r = Row().add(line, P.GREEN if i < 3 else P.GREEN_D)
        if i == 2:
            r.add("   NickOS", P.CYAN)
        if i == 3:
            r.add(f"   personal OS  v{VERSION}", P.GREEN_F)
        rows.append(r)
    return rows


def section(title, note=""):
    if PLAIN:
        r = Row().add(f"[ {title} ]", P.GREEN)
        if note:
            r.add(f"  {note}", P.GREEN_F)
        return r
    label = f"┤ {title} ├"
    note = f" {note} " if note else ""
    dashes = INNER - 2 - len(label) - len(note)
    r = Row().add("──", P.GREEN_F).add(label, P.GREEN)
    if note:
        r.add(note, P.GREEN_F)
    r.add("─" * max(0, dashes), P.GREEN_F)
    return r


# ─────────────────────────────────────────────────────────────────────────────
# panels
# ─────────────────────────────────────────────────────────────────────────────

def panel_system():
    rows = [section("SYSTEM")]

    mem = read_meminfo()
    if mem:
        total, avail, pct = mem
        rows.append(metric("MEM", pct,
                           f"{avail/1024:.1f} GiB free of {total/1024:.1f}"))
        if total / 1024 < 9:  # the 8 GB ceiling this whole design is built on
            head = int(os.environ.get("SPINE_RAM_HEADROOM_MB", 1024))
            ok = avail >= head + 200
            rows.append(Row()
                        .add("           night-window heavy job: ", P.GREEN_F)
                        .add("CLEAR" if ok else "BLOCKED",
                             P.GREEN if ok else P.AMBER)
                        .add(f"  (needs {head} MB headroom)", P.GREEN_F))
    else:
        rows.append(Row().add("  MEM      ", P.GREEN_D)
                    .add("unavailable — /proc not present (not Linux)", P.AMBER))

    swap = read_swap()
    if swap and swap[0] > 0:
        stotal, sused = swap
        spct = sused / stotal * 100
        rows.append(metric("SWAP", spct, f"{sused:.0f} MB of {stotal:.0f} MB",
                           warn=1.0, crit=20.0))

    disk = read_disk(spine_root())
    if disk:
        total, free, pct = disk
        rows.append(metric("DISK", pct, f"{free:.0f} GiB free of {total:.0f}"))

    la = read_loadavg()
    if la:
        cores = os.cpu_count() or 1
        pct = min(100.0, la[0] / cores * 100)
        rows.append(metric("LOAD", pct,
                           f"{la[0]:.2f} {la[1]:.2f} {la[2]:.2f} · {cores} cpu"))

    up = read_uptime()
    if up:
        rows.append(Row().add("  UPTIME   ", P.GREEN_D).add(up, P.CYAN))

    return rows


def panel_integrity():
    rows = [section("INTEGRITY")]
    for label, (state, detail, color) in (
        ("secrets", env_status()),
        ("itemdb", db_status()),
    ):
        rows.append(Row()
                    .add(f"  {label:<9}", P.GREEN_D)
                    .add(f"{state:<9}", color)
                    .add(detail, P.GREEN_F))
    state, detail, color = lock_status()
    rows.append(Row()
                .add(f"  {'flock':<9}", P.GREEN_D)
                .add(f"{state:<9}", color)
                .add(detail, P.GREEN_F))
    return rows


def panel_jobs():
    jobs, gap = load_jobs()
    live = [j for j in jobs if j.get("enabled", True)]
    rows = [section("SCHEDULE",
                    "" if gap else f"{len(live)} live / {len(jobs)}")]
    if gap:
        rows.append(Row().add("  -- ", P.GREEN_F)
                    .add(gap, P.GREEN_D)
                    .add("  -- nothing scheduled yet", P.GREEN_F))
        return rows
    if not jobs:
        rows.append(Row().add("  no collectors registered yet", P.GREEN_D))
        return rows

    rows.append(Row().add(
        "  JOB          SCHEDULE      WIN   WGT    RAM   LAST RUN", P.GREEN_F))

    outcome_color = {"ok": P.GREEN, "skipped": P.GREEN_D, "dry-run": P.CYAN,
                     "failed": P.RED, "timeout": P.RED}

    for j in jobs:
        last = str(j.get("last", "-"))
        if last != "-" and last.endswith("Z") and "T" in last:
            last = last[5:16].replace("T", " ")  # MM-DD HH:MM
        oc = str(j.get("outcome", "-"))
        rows.append(Row()
                    .add(f"  {j['id']:<12} ", P.WHITE if j.get("enabled", True)
                         else P.GREEN_F)
                    .add(f"{j['schedule']:<13} ", P.GREEN_D)
                    .add(f"{j.get('window','any'):<5} ", P.GREEN_D)
                    .add(f"{j.get('weight','light'):<6} ", P.GREEN_D)
                    .add(f"{j.get('ram_mb', 0):>4}M  ", P.GREEN_D)
                    .add(f"{last:<12}", P.CYAN)
                    .add(oc, outcome_color.get(oc, P.GREEN_F)))
    return rows


def panel_spend():
    spend, gap = load_spend()
    rows = [section("SPEND")]
    if gap:
        rows.append(Row().add("  -- ", P.GREEN_F).add(gap, P.AMBER))
        return rows

    # Measured against the TARGET, not the cap. The bar answers "how am I
    # doing against what this should cost", which is a question worth asking
    # monthly. The cap is a wall, not a goal, and a bar that sits at 4% all
    # month teaches you to ignore it.
    rows.append(metric("MTD", spend["pct_of_target"],
                       f"${spend['spent']:.4f} of ${spend['target']:.2f} target",
                       warn=80.0, crit=100.0))
    over = spend["over_target"]
    rows.append(Row()
                .add("           hard cap ", P.GREEN_F)
                .add(f"${spend['cap']:.2f}", P.CYAN)
                .add(f" · ${spend['left_to_cap']:.4f} before calls refuse",
                     P.GREEN_F))
    if over:
        rows.append(Row()
                    .add("           OVER TARGET", P.AMBER)
                    .add(f" by ${-spend['left_to_target']:.4f} — worth a look, "
                         "not an outage", P.GREEN_F))
    if not spend["calls"]:
        rows.append(Row().add("           no model calls recorded yet",
                              P.GREEN_F))
        return rows
    rows.append(Row().add(f"           {spend['calls']} call(s) this month",
                          P.GREEN_F))
    for job_id, usd, n in spend["jobs"]:
        rows.append(Row()
                    .add(f"    {job_id:<14}", P.GREEN_D)
                    .add(f"${usd:.6f}", P.CYAN)
                    .add(f"  {n} call(s)", P.GREEN_F))
    return rows


def panel_footer():
    host = socket.gethostname()
    now = datetime.now().astimezone()
    utc = datetime.now(timezone.utc)
    return [
        rule(),
        (Row()
         .add("  host ", P.GREEN_F).add(f"{host:<12}", P.CYAN)
         .add(" local ", P.GREEN_F).add(now.strftime("%Y-%m-%d %H:%M:%S %Z"), P.CYAN)
         .add("  utc ", P.GREEN_F).add(utc.strftime("%H:%M"), P.GREEN_D)),
        (Row()
         .add("  read-only assistant · draft-only email · nothing sends "
              "without you", P.GREEN_F)),
    ]


# ─────────────────────────────────────────────────────────────────────────────
# CRT bezel
# ─────────────────────────────────────────────────────────────────────────────

def frame(rows, scanlines=False):
    """Wrap the panels in a CRT bezel.

    Every emitted line is exactly MARGIN + BEZEL visible columns wide. The
    widths below are derived from INNER rather than hand-counted, because
    hand-counted box drawing is how you get a frame that is ragged on one
    row out of forty and nobody notices for a month.
    """
    B = P.GREEN_F
    MARGIN = "  "
    BEZEL = INNER + 8          # ║ │ <body> │ ║  -> 4 + INNER + 4
    SCREEN = INNER + 2         # ┌<...>┐ interior

    out = [f"{B}{MARGIN}╔{'═' * (BEZEL - 2)}╗{P.RESET}",
           f"{B}{MARGIN}║ ┌{'─' * SCREEN}┐ ║{P.RESET}"]

    for i, row in enumerate(rows):
        body = row.render(INNER)
        if scanlines and i % 2 == 1 and P.enabled:
            body = P.DIM + body + P.RESET
        out.append(f"{B}{MARGIN}║ │{P.RESET} {body} {B}│ ║{P.RESET}")

    out.append(f"{B}{MARGIN}║ └{'─' * SCREEN}┘ ║{P.RESET}")

    # power strip: ● PWR  ▄▄▄  D A R K W E B  ▄▄▄
    label = "  D A R K W E B  "
    lead = "  ● PWR  "
    tail = "  "
    fill = BEZEL - 2 - len(lead) - len(label) - len(tail)
    left = fill // 2
    right = fill - left
    out.append(
        f"{B}{MARGIN}║{P.RESET}  {P.GREEN}●{P.RESET}{P.GREEN_F} PWR  "
        f"{'▄' * left}{P.RESET}{P.GREEN_D}{label}{P.RESET}"
        f"{P.GREEN_F}{'▄' * right}{tail}{P.RESET}{B}║{P.RESET}")

    out.append(f"{B}{MARGIN}╚{'═' * (BEZEL - 2)}╝{P.RESET}")
    return out


def compose():
    rows = []
    rows += header()
    rows.append(blank())
    rows += panel_system()
    rows.append(blank())
    rows += panel_integrity()
    rows.append(blank())
    rows += panel_jobs()
    rows.append(blank())
    rows += panel_spend()
    rows += panel_footer()
    return rows


# ─────────────────────────────────────────────────────────────────────────────

def render(scanlines=False):
    return "\n".join(frame(compose(), scanlines))


def render_plain():
    """Same data as the console, no bezel and no color.

    bin/status is a wrapper around this rather than a second implementation,
    because two surfaces that fetch their own data eventually disagree, and
    the disagreement is always discovered at the worst moment.
    """
    global PLAIN
    PLAIN = True
    P.off()
    try:
        lines = []
        for row in compose():
            text = "".join(t for _, t in row.parts).rstrip()
            if set(text) and set(text) <= set("-\u2500 "):
                continue                       # drop horizontal rules
            lines.append(text)
        while lines and not lines[0].strip():
            lines.pop(0)
        return "\n".join(lines).rstrip() + "\n"
    finally:
        PLAIN = False


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="darkweb",
        description="Spine / NickOS console.")
    ap.add_argument("--watch", nargs="?", const=2.0, type=float, default=None,
                    metavar="SECONDS",
                    help="refresh continuously (default every 2s)")
    ap.add_argument("--no-color", action="store_true",
                    help="disable ANSI color")
    ap.add_argument("--scanlines", action="store_true",
                    help="CRT scanline effect")
    ap.add_argument("--plain", action="store_true",
                    help="plain text, no bezel or color (what bin/status runs)")
    ap.add_argument("--version", action="version", version=f"darkweb {VERSION}")
    args = ap.parse_args(argv)

    if args.no_color or not supports_color(sys.stdout):
        P.off()

    cols = shutil.get_terminal_size((80, 24)).columns
    if cols < INNER + 8 and sys.stdout.isatty():
        sys.stderr.write(
            f"darkweb: terminal is {cols} cols; needs {INNER + 8}. "
            "Widen the window.\n")

    if args.plain:
        P.off()
        print(render_plain(), end="")
        return 0

    if args.watch is None:
        print(render(args.scanlines))
        return 0

    try:
        sys.stdout.write("\033[?25l")  # hide cursor
        while True:
            sys.stdout.write("\033[H\033[2J")
            sys.stdout.write(render(args.scanlines) + "\n")
            sys.stdout.flush()
            time.sleep(max(0.5, args.watch))
    except KeyboardInterrupt:
        return 130
    finally:
        sys.stdout.write("\033[?25h\033[0m\n")  # show cursor, reset
        sys.stdout.flush()


if __name__ == "__main__":
    sys.exit(main())
