# Spine / NickOS secrets.
#
# Copy to .env and chmod 600. NEVER commit .env. NEVER put a key in a prompt.
#   cp .env.example .env && chmod 600 .env
#
# Nothing here is read until Phase 1 (model router + secrets migration).

# ── runtime ──────────────────────────────────────────────────────────
SPINE_ENV=prod
SPINE_TZ=America/New_York

# SPINE_ROOT is NOT set here on purpose. bin/run.sh derives it from its own
# location, so the checkout works wherever you clone it. Setting it here only
# creates a way for the two to disagree.
#
# SPINE_DB defaults to $SPINE_ROOT/var/spine.db. Uncomment only to put the
# item store on a different disk.
# SPINE_DB=/var/lib/spine/spine.db

# ── resource governor (see CLAUDE.md section 3) ─────────────────────────────
# Heavy jobs only run inside this window, local time.
SPINE_NIGHT_START=01:00
SPINE_NIGHT_END=06:00
# Refuse to start a heavy job unless this much RAM is free, in MB.
SPINE_RAM_HEADROOM_MB=1024

# ── model providers ──────────────────────────────────────────────────
# bulk tier. Google AI Studio free tier: fast enough, $0, and it LOGS
# PROMPTS — so core.models marks it logs_prompts=True and refuses to send
# any job whose META says data="private". Public data only, ever.
# Hermes already holds a key on this box.
GEMINI_API_KEY=

# smart / frontier tiers are EMPTY as of Phase 1. The Anthropic Console
# balance is $0 (the claude.ai credit is subscription-only and cannot fund
# the Dell) and no NVIDIA NIM key exists. Setting this key alone does not
# wire the tier — add the provider in core/models.py:default_tiers() too.
ANTHROPIC_API_KEY=

# ── spend guard ──────────────────────────────────────────────────────
# Two numbers, two jobs.
#
# CAP is the wall. Checked BEFORE each call against month-to-date plus a
# pessimistic estimate; over the line and the request is never sent. Set it
# well above normal usage — a cap you brush against monthly is one you will
# raise without thinking, and then it protects nothing.
SPINE_MONTHLY_USD_CAP=25.00

# TARGET is what the stack should actually cost. It refuses nothing; it is
# what the SPEND panel measures against, so the bar reads "how am I doing"
# rather than "how close to disaster".
SPINE_MONTHLY_USD_TARGET=5.00

# ── surfaces (Phase 3+) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
