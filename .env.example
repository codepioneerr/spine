# Spine / NickOS secrets.
#
# Copy to .env and chmod 600. NEVER commit .env. NEVER put a key in a prompt.
#   cp .env.example .env && chmod 600 .env
#
# Nothing here is read until Phase 1 (model router + secrets migration).

# ── runtime ──────────────────────────────────────────────────────────
SPINE_ENV=prod
SPINE_ROOT=/opt/spine
SPINE_DB=/opt/spine/var/spine.db
SPINE_TZ=America/New_York

# ── resource governor (see CLAUDE.md section 3) ─────────────────────────────
# Heavy jobs only run inside this window, local time.
SPINE_NIGHT_START=01:00
SPINE_NIGHT_END=06:00
# Refuse to start a heavy job unless this much RAM is free, in MB.
SPINE_RAM_HEADROOM_MB=1024

# ── model providers (Phase 1) ────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── spend guard (Phase 1) ────────────────────────────────────────────
SPINE_MONTHLY_USD_CAP=5.00

# ── surfaces (Phase 3+) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
